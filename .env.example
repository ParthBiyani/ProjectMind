# ProjectMind configuration. Copy to .env and edit; every value below is optional.

# Storage backend. Defaults to a local SQLite file under PROJECTMIND_HOME.
# Set a postgresql:// URL to use the Postgres + pgvector backend instead.
# PROJECTMIND_DB_URL=postgresql://projectmind:projectmind@localhost:5432/projectmind

# Where ProjectMind keeps its database, caches and logs.
# PROJECTMIND_HOME=~/.projectmind

# Optional. Unlocks LLM-backed extraction and the reflection loop.
# Everything works without it; the system falls back to deterministic heuristics.
# ANTHROPIC_API_KEY=

# Optional. Only needed to ingest repositories from the GitHub API.
# Local repositories are read straight off disk and need no token.
# GITHUB_TOKEN=
