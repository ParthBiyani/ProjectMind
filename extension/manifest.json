{
  "manifest_version": 3,
  "name": "ProjectMind Capture",
  "version": "0.2.0",
  "description": "Sends pages you read on a short list of documentation sites to ProjectMind on this computer. Nothing leaves the machine.",
  "minimum_chrome_version": "116",
  "permissions": [
    "storage",
    "alarms",
    "tabs",
    "scripting",
    "activeTab"
  ],
  "host_permissions": [
    "http://127.0.0.1/*",
    "https://*.arxiv.org/*",
    "https://*.dart.dev/*",
    "https://*.developer.mozilla.org/*",
    "https://*.docs.anthropic.com/*",
    "https://*.docs.docker.com/*",
    "https://*.docs.github.com/*",
    "https://*.docs.opencv.org/*",
    "https://*.docs.pydantic.dev/*",
    "https://*.docs.python.org/*",
    "https://*.docs.sqlalchemy.org/*",
    "https://*.docs.ultralytics.com/*",
    "https://*.fastapi.tiangolo.com/*",
    "https://*.flutter.dev/*",
    "https://*.git-scm.com/*",
    "https://*.github.com/*",
    "https://*.huggingface.co/*",
    "https://*.kaggle.com/*",
    "https://*.kubernetes.io/*",
    "https://*.langchain-ai.github.io/*",
    "https://*.langchain.com/*",
    "https://*.learn.microsoft.com/*",
    "https://*.lightgbm.readthedocs.io/*",
    "https://*.nextjs.org/*",
    "https://*.nodejs.org/*",
    "https://*.numpy.org/*",
    "https://*.opencv.org/*",
    "https://*.pandas.pydata.org/*",
    "https://*.paperswithcode.com/*",
    "https://*.platform.openai.com/*",
    "https://*.postgresql.org/*",
    "https://*.pub.dev/*",
    "https://*.pypi.org/*",
    "https://*.python.langchain.com/*",
    "https://*.pytorch.org/*",
    "https://*.react.dev/*",
    "https://*.readthedocs.io/*",
    "https://*.scikit-learn.org/*",
    "https://*.sqlite.org/*",
    "https://*.stackexchange.com/*",
    "https://*.stackoverflow.com/*",
    "https://*.supabase.com/*",
    "https://*.tailwindcss.com/*",
    "https://*.typescriptlang.org/*",
    "https://*.wandb.ai/*",
    "https://*.xgboost.readthedocs.io/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://*.arxiv.org/*",
        "https://*.dart.dev/*",
        "https://*.developer.mozilla.org/*",
        "https://*.docs.anthropic.com/*",
        "https://*.docs.docker.com/*",
        "https://*.docs.github.com/*",
        "https://*.docs.opencv.org/*",
        "https://*.docs.pydantic.dev/*",
        "https://*.docs.python.org/*",
        "https://*.docs.sqlalchemy.org/*",
        "https://*.docs.ultralytics.com/*",
        "https://*.fastapi.tiangolo.com/*",
        "https://*.flutter.dev/*",
        "https://*.git-scm.com/*",
        "https://*.github.com/*",
        "https://*.huggingface.co/*",
        "https://*.kaggle.com/*",
        "https://*.kubernetes.io/*",
        "https://*.langchain-ai.github.io/*",
        "https://*.langchain.com/*",
        "https://*.learn.microsoft.com/*",
        "https://*.lightgbm.readthedocs.io/*",
        "https://*.nextjs.org/*",
        "https://*.nodejs.org/*",
        "https://*.numpy.org/*",
        "https://*.opencv.org/*",
        "https://*.pandas.pydata.org/*",
        "https://*.paperswithcode.com/*",
        "https://*.platform.openai.com/*",
        "https://*.postgresql.org/*",
        "https://*.pub.dev/*",
        "https://*.pypi.org/*",
        "https://*.python.langchain.com/*",
        "https://*.pytorch.org/*",
        "https://*.react.dev/*",
        "https://*.readthedocs.io/*",
        "https://*.scikit-learn.org/*",
        "https://*.sqlite.org/*",
        "https://*.stackexchange.com/*",
        "https://*.stackoverflow.com/*",
        "https://*.supabase.com/*",
        "https://*.tailwindcss.com/*",
        "https://*.typescriptlang.org/*",
        "https://*.wandb.ai/*",
        "https://*.xgboost.readthedocs.io/*"
      ],
      "js": [
        "lib.js",
        "extract.js",
        "content.js"
      ],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "action": {
    "default_title": "ProjectMind",
    "default_popup": "popup.html"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  }
}
