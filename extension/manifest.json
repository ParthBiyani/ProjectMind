{
  "manifest_version": 3,
  "name": "ProjectMind Capture",
  "version": "0.3.0",
  "description": "Sends the pages you read to ProjectMind on this computer, except sites on your never-capture list. Nothing leaves the machine.",
  "minimum_chrome_version": "116",
  "incognito": "not_allowed",
  "permissions": [
    "storage",
    "alarms",
    "tabs",
    "scripting",
    "activeTab"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "lib.js",
        "extract.js",
        "content.js"
      ],
      "run_at": "document_idle",
      "all_frames": false,
      "exclude_matches": [
        "*://localhost/*",
        "*://127.0.0.1/*",
        "*://*.local/*",
        "*://*.localhost/*"
      ]
    }
  ],
  "action": {
    "default_title": "ProjectMind",
    "default_popup": "popup.html"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  }
}
